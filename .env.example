# ════════════════════════════════════════════════════════════════
#  Restaurant POS — Environment Variables Template
#  1. Copy this file:   cp .env.example .env
#  2. Fill in your values below.
#  3. NEVER commit .env to git — it is in .gitignore.
# ════════════════════════════════════════════════════════════════


# ─── Database ───────────────────────────────────────────────────
#
# Any MySQL-compatible database works (the app uses the mysql2 driver).
# PostgreSQL, MongoDB, SQLite etc. are NOT supported.
#
# Option A: Local MySQL or MariaDB (self-hosted)
#   Install MySQL:  https://dev.mysql.com/downloads/mysql/
#   Or MariaDB:     https://mariadb.org/download/
#   Then create a DB:
#     mysql -u root -p
#     CREATE DATABASE restaurant_pos;
#   DB_HOST=localhost | DB_PORT=3306
#
# Option B: TiDB Serverless — free cloud MySQL (recommended for Vercel)
#   1. Sign up free at https://tidbcloud.com
#   2. Create a "Serverless" cluster → Connect → copy the details
#   DB_PORT=4000  (TiDB uses 4000 instead of 3306)
#
# Option C: PlanetScale — free serverless MySQL
#   https://planetscale.com  → New database → Connect → Passwords
#   DB_PORT=3306
#
# Option D: Railway — easy cloud MySQL (free starter tier)
#   https://railway.app → New Project → MySQL → Variables tab
#   DB_PORT=3306
#
# Option E: AWS RDS / Google Cloud SQL / Azure Database for MySQL
#   Use the endpoint hostname and credentials from your cloud console.
#
DB_HOST=localhost
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=restaurant_pos


# ─── JWT Secret ─────────────────────────────────────────────────
#
# A random secret string used to sign login tokens.
# Must be at least 32 characters. Keep this private.
#
# Generate one by running this command in your terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Or use an online generator: https://generate-secret.vercel.app/64
#
JWT_SECRET=change-me-to-a-random-secret-min-32-chars


# ─── Server Port ────────────────────────────────────────────────
#
# The local port the backend server listens on.
# Default is 3000. Change if port 3000 is already in use.
# On Vercel, this is ignored (Vercel manages ports automatically).
#
PORT=3000


# ─── CORS Allowed Origins ───────────────────────────────────────
#
# Which frontend URLs are allowed to call the API.
# For local development: http://localhost:3000
# For production: set to your deployed frontend URL(s).
#   Example: https://your-pos.vercel.app,https://yourdomain.com
# Multiple origins separated by commas (no spaces).
#
ALLOWED_ORIGINS=http://localhost:3000


# ─── MQTT Cloud Printing (optional) ─────────────────────────────
#
# Only needed if you use the ESP32 wireless print bridge.
# If you don't have a printer, leave these blank — the app
# works fine without printing.
#
# MQTT is a lightweight messaging protocol. You need a broker
# (a server that relays print jobs to your ESP32).
#
# Free MQTT broker options:
#
#   Option A: HiveMQ Cloud (easiest — free tier, no setup)
#     1. Sign up at https://www.hivemq.com/mqtt-cloud-broker/
#     2. Create a free cluster
#     3. Go to "Access Management" → create a username + password
#     4. Copy the "Host" from the Overview tab
#     MQTT_HOST = xxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud
#     MQTT_PORT on ESP32 = 8883 (TLS)
#
#   Option B: EMQX Cloud (free tier available)
#     1. Sign up at https://www.emqx.com/en/cloud
#     2. Create a free Serverless deployment
#     3. Go to Authentication → add username/password
#     4. Copy the connection address
#
#   Option C: Self-hosted Mosquitto (advanced)
#     Install on a Raspberry Pi or VPS:
#       sudo apt install mosquitto mosquitto-clients
#     Configure auth in /etc/mosquitto/mosquitto.conf
#
MQTT_HOST=your-mqtt-host.example.com
MQTT_USER=your-mqtt-username
MQTT_PASS=your-mqtt-password


# ─── Test Database Mode ──────────────────────────────────────────
#
# When set to "true", all billing and orders go to a separate
# test database (DB_NAME + "_test") instead of your live data.
# Use this only in a local test or CI/CD environment.
# NEVER set to "true" in production.
#
USE_TEST_DB=false
