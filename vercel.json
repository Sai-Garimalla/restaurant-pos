{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["../.env"]
      }
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/server.js",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/assets/(.*\\.(png|jpg|jpeg|svg|gif|webp|ico))",
      "dest": "/client/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/css/(.*\\.css)",
      "dest": "/client/css/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/js/(.*\\.js)",
      "dest": "/client/js/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/(.*\\.(html))",
      "dest": "/client/$1",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/client/$1"
    }
  ]
}
